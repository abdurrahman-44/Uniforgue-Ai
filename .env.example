# ==============================================================================
# UNIFORGE AI — Environment Configuration Example
# Copy this file to .env and populate secrets before running in production.
# NEVER commit real API keys or secrets to version control.
# ==============================================================================

# --- Application ---
APP_NAME=UNIFORGE AI
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security & Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-64-char-cryptographically-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET=change-me-to-a-random-csrf-secret
ENCRYPTION_KEY=change-me-to-a-32-byte-url-safe-base64-fernet-key

# --- Database ---
# Production / Docker PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://uniforge:uniforge_dev_pass@postgres:5432/uniforge_ai
# DATABASE_URL_SYNC=postgresql+psycopg://uniforge:uniforge_dev_pass@postgres:5432/uniforge_ai
# Local zero-setup development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./uniforge_dev.db
DATABASE_URL_SYNC=sqlite:///./uniforge_dev.db

# --- Redis & Background Worker ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
USE_INLINE_JOB_RUNNER=true

# --- Object Storage (S3 / MinIO or Local Dev) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage_data
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=uniforge-assets
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=50
DEFAULT_USER_STORAGE_QUOTA_MB=500

# --- AI Language Intelligence (GPT-6 Astra Primary + Fallbacks) ---
# Primary: OpenAI GPT-6 Astra (https://api.openai.com/v1/responses or /v1/chat/completions)
AI_PRIMARY_PROVIDER=openai_astra
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ASTRA_MODEL=gpt-6-astra
OPENAI_ASTRA_REASONING_EFFORT=medium

# Optional OpenAI-Compatible Endpoint (OpenRouter, Groq, Azure Foundry, Together, vLLM)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Optional Local Self-Hosted Ollama (Completely Free Local Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- AI Image Generation Providers ---
# Supported: openai | stability | huggingface | comfyui | none
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-1

# --- AI Video Generation Providers ---
# Supported: runway | replicate | local_ffmpeg | none
VIDEO_PROVIDER=local_ffmpeg
VIDEO_API_KEY=
VIDEO_BASE_URL=
FFMPEG_BINARY=ffmpeg

# --- Academic Research APIs (Free Public Access) ---
CROSSREF_MAILTO=research@uniforge.ai
OPENALEX_MAILTO=research@uniforge.ai
SEMANTIC_SCHOLAR_API_KEY=

# --- Fair-Use Limits (Free Platform Policy) ---
FAIR_USE_AI_REQUESTS_PER_DAY=100
FAIR_USE_IMAGES_PER_DAY=20
FAIR_USE_VIDEOS_PER_DAY=5
FAIR_USE_EXPORTS_PER_DAY=50
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# --- Email / SMTP (Optional; logs verification links in dev mode) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@uniforge.ai

# --- Frontend Public Env ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=UNIFORGE AI
